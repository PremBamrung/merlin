# Copy to .env and fill in your values:  cp .env.example .env

# DB lives in ./data (mounted as /app/data) and survives container rebuilds.
# Use DELETE journal mode on a macOS Docker bind mount: WAL is unsafe there —
# uncheckpointed commits in the -wal file can be lost when the container stops.
# On a NAS/Linux bind mount (ext4/zfs), WAL is safe and faster.
DATABASE_URL="sqlite:////app/data/merlin.db"
SQLITE_JOURNAL_MODE="DELETE"

# --- LLM provider for every path (summarise / classify / chat) ---
# "openrouter" (default) or "litellm" (the LiteLLM proxy, e.g. Gemini on Vertex).
LLM_PROVIDER=openrouter

# --- OpenRouter ---
OPENROUTER_ENDPOINT="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_DEPLOYMENT="@preset/deepseek-v4-flash-direct"

# --- LiteLLM proxy (used when LLM_PROVIDER=litellm) ---
# From inside Merlin's container, localhost is the container itself — address
# the proxy's host (Tailscale name, Tailscale IP or LAN IP).
LITELLM_BASE_URL="http://omv:4000/v1"
# A LiteLLM virtual key for Merlin, not the master key.
LITELLM_API_KEY=""
# Proxy model_name aliases (from its config.yaml), not Vertex ids.
LITELLM_MODEL="gemini-3.8-flash"
LITELLM_WEB_SEARCH_MODEL="gemini-web-search"
# Reasoning effort for summarise + classify: minimal | low | medium | high.
# Chat picks its own level per message in the composer.
INGEST_THINKING_LEVEL=medium

# Groq — fallback audio transcriber when no YouTube transcript is available.
GROQ_API_KEY=""

# Optional: Netscape-format cookies.txt exported from a browser signed in to
# YouTube. Sent with transcript fetches and audio downloads — helps when
# YouTube blocks this server. Put it under ./data so Docker can see it.
YOUTUBE_COOKIES_FILE=""
# YOUTUBE_COOKIES_FILE="/app/data/youtube_cookies.txt"

# Top-level comments kept per video (fetched at ingest; ground the summary's
# "What Viewers Say" section, the Reader's Comments tab and chat). 0 = off.
YOUTUBE_COMMENTS_LIMIT=20
# Minimum seconds between comment fetches across all workers (avoids bursts
# that get the IP blocked). The IP-block pause is shared with subtitles.
YOUTUBE_COMMENTS_MIN_INTERVAL=5

# --- Embeddings / reranking (Jina) — for hybrid semantic search ---
# "none" → NullEmbedder (pure FTS5 keyword search); "jina" → Jina cloud vectors + rerank.
EMBEDDING_PROVIDER=none
JINA_API_KEY=""
JINA_EMBEDDING_MODEL="jina-embeddings-v5-text-small"
JINA_RERANKER_MODEL="jina-reranker-v3"
